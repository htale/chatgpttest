[Script]
http-response ^https:\/\/www\.mypaga\.com\/paga-webservices\/customer-mobile\/secured\/getUserData\/v3(?:\?.*)?$ script-path=https://raw.githubusercontent.com/niuniujun-argun/Scripy/main/Paga/JavaScript/card.js,requires-body=true,timeout=10,tag=Paga,enable=true

[Mitm]
hostname = www.mypaga.com
